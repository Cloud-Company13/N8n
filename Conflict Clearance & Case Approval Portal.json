              "defaultValue": "Accept Case & Clear Conflict",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Accept Case & Clear Conflict"
                  },
                  {
                    "option": "Reject & Decline Case"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Resolution Comments / Justification",
              "fieldType": "textarea",
              "placeholder": "Enter reason, formal waiver reference, or grounds for decline...",
              "requiredField": true
