      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "rule-onboarding",
                    "leftValue": "={{ ($json.milestone_type || '').toString().toLowerCase().trim() }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "onboarding_welcome"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Welcome email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "rule-paper-filed",
                    "leftValue": "={{ ($json.milestone_type || '').toString().toLowerCase().trim() }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "paper filed"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Paper filled email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "rule-hearing-trial",
                    "leftValue": "={{ ['hearing', 'under-trial', 'under trial', 'undertrial'].includes(($json.milestone_type || '').toString().toLowerCase().trim()) }}",
                    "operator": {
                      "operation": "true",
                      "singleValue": true,
                      "type": "boolean"
                    },
                    "rightValue": true
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hearing email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "rule-judgment",
                    "leftValue": "={{ ['final judgment', 'final judgement', 'judgment', 'judgement'].includes(($json.milestone_type || '').toString().toLowerCase().trim()) }}",
                    "operator": {
                      "operation": "true",
                      "singleValue": true,
                      "type": "boolean"
                    },
                    "rightValue": true
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Final judgement email"
            }
          ]
        },
