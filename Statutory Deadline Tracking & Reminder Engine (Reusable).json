    {
      "parameters": {
        "jsCode": "const trig = $('Check Action').first().json || {};\nconst deadlineName = (trig.deadline_name || 'Written Statement').toString().trim();\nconst ruleKey = deadlineName.toLowerCase();\n\n// Baseline default rules using registered variables\nconst defaultRules = {\n  \"written statement\": {\n    statutory_days: Number($vars.DEFAULT_STATUTORY_LIMITATION_DAYS || 30),\n    alert_days: Number($vars.STATUTORY_ALERT_LEAD_DAYS || 15)\n  },\n  \"rejoinder / reply\": {\n    statutory_days: 14,\n    alert_days: 7\n  }\n};\n\nlet rules = defaultRules;\nif ($vars.STATUTORY_RULES_CONFIG) {\n  try {\n    const parsed = typeof $vars.STATUTORY_RULES_CONFIG === 'string'\n      ? JSON.parse($vars.STATUTORY_RULES_CONFIG)\n      : $vars.STATUTORY_RULES_CONFIG;\n    if (parsed && typeof parsed === 'object') {\n      rules = parsed;\n    }\n  } catch (e) {\n    rules = defaultRules;\n  }\n}\n\nlet matched = null;\nfor (const [name, rule] of Object.entries(rules)) {\n  if (name.toLowerCase() === ruleKey) {\n    matched = rule;\n    break;\n  }\n}\n\nconst statutoryDays = Number(matched?.statutory_days || $vars.DEFAULT_STATUTORY_LIMITATION_DAYS || 30);\nconst alertDays = Number(matched?.alert_days || $vars.STATUTORY_ALERT_LEAD_DAYS || 15);\n\nreturn [{\n  json: {\n    rule_name: deadlineName,\n    statutory_days: statutoryDays,\n    alert_days: alertDays\n  }\n}];"
      },
