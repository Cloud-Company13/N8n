      "parameters": {
        "jsCode": "const intakeItem = $input.first();\nconst raw = intakeItem.json || {};\n\nconst clientName = (raw.client_name || raw['Full Name'] || '').trim();\nconst clientEmail = (raw.client_email || raw['Email Address'] || '').trim().toLowerCase();\nconst location = (raw.location || raw['Location'] || '').trim();\nconst address = (raw.address || raw['Address'] || '').trim();\nconst pincode = (raw.pincode || raw['Pincode'] || '').toString().trim();\n\nconst generatedId = Math.floor(100000 + Math.random() * 900000).toString();\n\nreturn [{\n  json: {\n    ...raw,\n    case_id: generatedId,\n    client_name: clientName,\n    client_email: clientEmail,\n    location: location,\n    address: address,\n    pincode: pincode,\n    case_status: 'active',\n    legal_proceeding_stage: 'paper filed'\n  },\n  pairedItem: { item: 0 },\n  binary: intakeItem.binary || undefined\n}];"
      },
