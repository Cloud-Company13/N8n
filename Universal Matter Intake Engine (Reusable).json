    {
      "parameters": {
        "sendTo": "={{ $vars.FIRM_ADMIN_EMAIL }}",
        "subject": "={{ $('Execute Conflict Check Engine').first().json.conflict_status !== 'Clear' ? ('🚨 CONFLICT ALERT: New Client Intake - ' + $('Generate Case ID').first().json.client_name + ' (Case #' + $('Generate Case ID').first().json.case_id + ')') : ('New Client Intake: ' + $('Generate Case ID').first().json.client_name + ' (Case #' + $('Generate Case ID').first().json.case_id + ')') }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; background-color: #ffffff;\">\n  <div style=\"background-color: #0f172a; padding: 16px 20px; border-radius: 6px; margin-bottom: 20px;\">\n    <h2 style=\"color: #ffffff; margin: 0; font-size: 20px;\">⚖️ Legal Firm Administration — New Matter Intake</h2>\n  </div>\n  \n  <p style=\"font-size: 15px; color: #334155; line-height: 1.5;\">\n    Hello Firm Administrator & Advocate,\n  </p>\n  <p style=\"font-size: 14px; color: #334155; line-height: 1.5;\">\n    A new matter has been submitted and ingested into the case directory with digital vault storage and automated Jotter brief generation.\n  </p>\n\n  {{ $('Execute Conflict Check Engine').first().json.conflict_status !== 'Clear' ? ('<div style=\"background-color: #fef2f2; border: 2px solid #ef4444; border-radius: 8px; padding: 16px; margin: 20px 0;\"><h3 style=\"color: #b91c1c; margin: 0 0 8px 0; font-size: 16px;\">🚨 Potential Conflict of Interest Detected</h3><p style=\"color: #991b1b; font-size: 14px; margin: 0 0 10px 0;\"><strong>Alert Details:</strong> ' + $('Execute Conflict Check Engine').first().json.conflict_details + '</p><p style=\"color: #7f1d1d; font-size: 13px; margin: 0;\"><strong>Action Required:</strong> Review this conflict in Case Management. You may either <em>Accept & Proceed</em> (if waived or distinct party) or <em>Reject & Decline</em> the representation.</p></div>') : ('<div style=\"background-color: #f0fdf4; border: 1px solid #86efac; border-radius: 6px; padding: 10px 14px; margin: 16px 0;\"><span style=\"color: #15803d; font-weight: bold; font-size: 14px;\">✅ Conflict Check: CLEAR</span> <span style=\"color: #166534; font-size: 13px;\">(No opposing party overlap found in case directory)</span></div>') }}\n\n  <div style=\"background-color: #f8fafc; border-left: 4px solid #2563eb; padding: 14px 18px; margin: 20px 0; border-radius: 4px;\">\n    <h3 style=\"margin-top: 0; color: #1e293b; font-size: 15px;\">📋 Matter Details</h3>\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b; width: 140px;\"><strong>Case ID:</strong></td>\n        <td style=\"padding: 6px 0; color: #0f172a;\"><code style=\"background-color: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-weight: bold;\">{{ $('Generate Case ID').first().json.case_id }}</code></td>\n      </tr>\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b;\"><strong>Client Name:</strong></td>\n        <td style=\"padding: 6px 0; color: #0f172a; font-weight: bold;\">{{ $('Generate Case ID').first().json.client_name }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b;\"><strong>Client Email:</strong></td>\n        <td style=\"padding: 6px 0; color: #0f172a;\"><a href=\"mailto:{{ $('Generate Case ID').first().json.client_email }}\" style=\"color: #2563eb;\">{{ $('Generate Case ID').first().json.client_email }}</a></td>\n      </tr>\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b;\"><strong>Opposing Party:</strong></td>\n        <td style=\"padding: 6px 0; color: #0f172a; font-weight: bold;\">{{ $('Execute AI Document & Vault Triage').first().json.adverse_party || $('Execute Conflict Check Engine').first().json.adverse_party || 'None identified' }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b;\"><strong>Location / PIN:</strong></td>\n        <td style=\"padding: 6px 0; color: #0f172a;\">{{ $('Generate Case ID').first().json.location }} - {{ $('Generate Case ID').first().json.pincode }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 6px 0; color: #64748b;\"><strong>Urgency Assessment:</strong></td>\n        <td style=\"padding: 6px 0;\"><span style=\"background-color: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase;\">{{ $('Execute AI Document & Vault Triage').first().json.urgency_level || 'Medium' }}</span></td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"background-color: #f0fdf4; border: 1px solid #86efac; padding: 18px; margin: 20px 0; border-radius: 8px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\">\n      <h3 style=\"margin: 0; color: #166534; font-size: 16px;\">📁 Digital Vault & Legal Intelligence</h3>\n    </div>\n    \n    <p style=\"margin: 0 0 12px 0; font-size: 14px; color: #1f2937;\">\n      <strong>Title:</strong> {{ $('Execute AI Document & Vault Triage').first().json.document_title || 'Legal Document' }}<br/>\n      <strong>Category:</strong> {{ $('Execute AI Document & Vault Triage').first().json.document_category || 'General Matter' }}\n    </p>\n\n    <div style=\"display: flex; flex-direction: column; gap: 8px; margin: 14px 0;\">\n      {{ $('Execute AI Document & Vault Triage').first().json.document_url ? ('<div><a href=\"' + $('Execute AI Document & Vault Triage').first().json.document_url + '\" target=\"_blank\" style=\"background-color: #16a34a; color: #ffffff; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; font-size: 13px; display: inline-block;\">📄 View Original Document in Vault &rarr;</a></div>') : '<p style=\"color: #6b7280; font-style: italic;\">No document uploaded during intake.</p>' }}\n      {{ $('Execute AI Document & Vault Triage').first().json.jotter_url ? ('<div><a href=\"' + $('Execute AI Document & Vault Triage').first().json.jotter_url + '\" target=\"_blank\" style=\"background-color: #4f46e5; color: #ffffff; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; font-size: 13px; display: inline-block;\">📝 Open Jotter Note / AI Legal Brief (Google Drive) &rarr;</a></div>') : '' }}\n    </div>\n\n    <div style=\"background: #ffffff; border: 1px solid #dcfce7; border-radius: 6px; padding: 12px; margin-top: 14px;\">\n      <h4 style=\"margin: 0 0 8px 0; color: #15803d; font-size: 14px;\">📋 Key Case Points:</h4>\n      <ul style=\"margin: 0; padding-left: 20px; color: #374151; font-size: 13px; line-height: 1.6;\">\n        {{ ($('Execute AI Document & Vault Triage').first().json.document_summary || '').split('\\n').filter(l => l.trim()).map(l => '<li style=\"margin-bottom: 4px;\">' + l.replace(/^[••\\*]\\s*/, '').trim() + '</li>').join('') }}\n      </ul>\n    </div>\n  </div>\n\n  <div style=\"text-align: center; margin: 28px 0;\">\n    <a href=\"https://sahil8249.app.n8n.cloud/form/823e368f-b87a-4251-a8c0-968897515f4c\" style=\"background-color: #2563eb; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: bold; font-size: 15px; display: inline-block;\">👉 Open Case Management & Assign Advocate</a>\n  </div>\n\n  <p style=\"font-size: 12px; color: #94a3b8; text-align: center; margin-top: 24px; border-top: 1px solid #f1f5f9; padding-top: 16px;\">\n    Case Reference: {{ $('Generate Case ID').first().json.case_id }} • Legal Practice Automation System\n  </p>\n</div>",
        "options": {}
      },
